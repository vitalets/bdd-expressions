{
  "name": "bdd-expressions",
  "description": "Expressive syntax for BDD step definitions",
  "version": "0.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitalets/bdd-expressions.git"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "npm run lint -- --fix",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "tsc": "tsc --noEmit",
    "test": "tsx --test test/*.spec.ts test/*/*.spec.ts",
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "update:rules": "cp ../agentic-dev/rules/ts-file-structure/ts-file-structure.md .agents/rules/",
    "update:compatibility": "node scripts/update-compatibility-testdata.mjs",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "tsc -p site/tsconfig.json && vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "site:deploy": "git checkout site && git pull --no-edit && git merge --no-edit main && git push origin site && git checkout main"
  },
  "devDependencies": {
    "@cucumber/cucumber-expressions": "20.1.0",
    "@types/node": "^20.19.43",
    "lint-staged": "17.6.0",
    "marked": "^18.1.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "yaml": "2.9.1"
  },
  "funding": "https://github.com/sponsors/vitalets",
  "keywords": [
    "bdd",
    "cucumber",
    "expressions",
    "testing",
    "typescript"
  ],
  "license": "MIT"
}
