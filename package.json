{
  "name": "bdd-expressions",
  "version": "0.1.0",
  "description": "BDD expressions with named parameters, nested optionals and capture metadata",
  "keywords": [
    "bdd",
    "cucumber",
    "expressions",
    "testing",
    "typescript"
  ],
  "homepage": "https://github.com/vitalets/bdd-expressions#readme",
  "bugs": {
    "url": "https://github.com/vitalets/bdd-expressions/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitalets/bdd-expressions.git"
  },
  "funding": "https://github.com/sponsors/vitalets",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run fmt && npm run lint && npm run typecheck && npm run build && npm test",
    "prepack": "npm run build",
    "prepare": "node scripts/install-hooks.mjs",
    "tsc": "npm run typecheck",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "npm run lint -- --fix",
    "fmt": "oxfmt --check .",
    "fmt:write": "oxfmt --write .",
    "prettier": "npm run fmt",
    "test:example": "npm run build && node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber-expressions": "20.1.0",
    "@types/node": "26.6.5",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
