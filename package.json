{
  "name": "bdd-expressions",
  "description": "Expressive syntax for BDD step definitions",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitalets/bdd-expressions.git"
  },
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "test": "node --test 'test/**/*.spec.ts'",
    "tsc": "tsc --noEmit",
    "check": "npm run fmt && npm run lint && npm run tsc && npm run build && npm test",
    "prepack": "npm run build",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "npm run lint -- --fix",
    "fmt": "oxfmt --check .",
    "fmt:write": "oxfmt --write .",
    "update:rules": "cp ../agentic-dev/rules/ts-file-structure/ts-file-structure.md .agents/rules/",
    "update:compatibility": "node scripts/update-compatibility-testdata.mjs",
    "prettier": "npm run fmt"
  },
  "devDependencies": {
    "@cucumber/cucumber-expressions": "20.1.0",
    "@types/node": "26.6.5",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "funding": "https://github.com/sponsors/vitalets",
  "keywords": [
    "bdd",
    "cucumber",
    "expressions",
    "testing",
    "typescript"
  ],
  "license": "MIT"
}
