{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortPackageJson": false,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "printWidth": 100,
  "semi": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "test/compatibility/testdata/**",
    "package-lock.json",
    ".github/workflows/release.yaml"
  ]
}
